{
  "schema": "tpw.simple/1",
  "note": "The quick forms. Deliberately small: one screen each. Read by intake/js/simple.js and scripts/intake_simple.py.",
  "forms": [
    {
      "kind": "session",
      "label": "Session",
      "title": "Log one session",
      "blurb": "One organization per entry, one session in one room. The same record whether the count came from a scanned sheet or from typing it in.",
      "submit": "File the session",
      "fields": [
        {
          "key": "org",
          "label": "Organization",
          "type": "text",
          "required": true,
          "datalist": "orgs",
          "placeholder": "Defy Ventures",
          "help": "You are filing as this organization. Everything on this entry is attributed to it."
        },
        {
          "key": "program",
          "label": "Program",
          "type": "text",
          "required": true,
          "datalist": "programs",
          "placeholder": "Guiding Rage Into Power"
        },
        {
          "key": "facility",
          "label": "Facility",
          "type": "facility",
          "required": true
        },
        {
          "key": "session_date",
          "label": "Session date",
          "type": "date",
          "required": true,
          "half": true
        },
        {
          "key": "session_no",
          "label": "Session number",
          "type": "integer",
          "min": 1,
          "max": 99,
          "half": true
        },
        {
          "key": "present_count",
          "label": "People present",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 60,
          "half": true
        },
        {
          "key": "walkins",
          "label": "Walk-ins",
          "type": "integer",
          "min": 0,
          "max": 60,
          "half": true
        },
        {
          "key": "notes",
          "label": "Anything to flag?",
          "type": "textarea",
          "max": 400
        },
        {
          "key": "sheet",
          "label": "Sheet code",
          "type": "text",
          "hidden": true,
          "max": 16
        },
        {
          "key": "roster",
          "label": "Roster IDs",
          "type": "list",
          "hidden": true,
          "max_items": 60,
          "max_length": 12
        },
        {
          "key": "present",
          "label": "Present IDs",
          "type": "list",
          "hidden": true,
          "max_items": 60,
          "max_length": 12
        },
        {
          "key": "roster_size",
          "label": "Roster size",
          "type": "integer",
          "hidden": true,
          "min": 0,
          "max": 60
        },
        {
          "key": "checked_count",
          "label": "Rows ticked",
          "type": "integer",
          "hidden": true,
          "min": 0,
          "max": 60
        }
      ]
    },
    {
      "kind": "aggregate",
      "label": "Quarter",
      "title": "Report the quarter",
      "blurb": "One organization per entry. One row per program per quarter, for an org that counts its own numbers. If you file sessions, don't also file the quarter.",
      "tab": false,
      "submit": "Add the quarter",
      "fields": [
        {
          "key": "org",
          "label": "Organization",
          "type": "text",
          "required": true,
          "datalist": "orgs",
          "placeholder": "Defy Ventures"
        },
        {
          "key": "program",
          "label": "Program",
          "type": "text",
          "required": true,
          "datalist": "programs",
          "placeholder": "CEO of Your New Life"
        },
        {
          "key": "facilities",
          "label": "Facilities",
          "type": "facilities",
          "required": true,
          "help": "Add every facility this quarter's totals cover. If you track them separately, file one entry per facility instead."
        },
        {
          "key": "quarter",
          "label": "Quarter",
          "type": "select",
          "required": true,
          "options": [
            "2025-Q1",
            "2025-Q2",
            "2025-Q3",
            "2025-Q4",
            "2026-Q1",
            "2026-Q2",
            "2026-Q3",
            "2026-Q4",
            "2027-Q1",
            "2027-Q2",
            "2027-Q3",
            "2027-Q4"
          ],
          "half": true
        },
        {
          "key": "served",
          "label": "People served",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 20000,
          "half": true
        },
        {
          "key": "completed",
          "label": "People who completed",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 20000,
          "half": true
        },
        {
          "key": "sessions_held",
          "label": "Sessions held",
          "type": "integer",
          "min": 0,
          "max": 500,
          "half": true
        },
        {
          "key": "attendance",
          "label": "Total attendances",
          "type": "integer",
          "min": 0,
          "max": 100000,
          "half": true,
          "help": "Everyone at every session, counted each time."
        },
        {
          "key": "demographics",
          "label": "Who the totals cover",
          "type": "counts",
          "max": 20000,
          "help": "Counts only, never names. Leave blank whatever you don't track.",
          "items": [
            {
              "key": "age_under_25",
              "label": "Under 25"
            },
            {
              "key": "age_25_34",
              "label": "25–34"
            },
            {
              "key": "age_35_44",
              "label": "35–44"
            },
            {
              "key": "age_45_54",
              "label": "45–54"
            },
            {
              "key": "age_55_plus",
              "label": "55+"
            },
            {
              "key": "gender_men",
              "label": "Men"
            },
            {
              "key": "gender_women",
              "label": "Women"
            },
            {
              "key": "gender_other",
              "label": "Another identity"
            },
            {
              "key": "race_asian_pacific",
              "label": "Asian / Pacific Islander"
            },
            {
              "key": "race_black",
              "label": "Black"
            },
            {
              "key": "race_hispanic",
              "label": "Hispanic / Latino"
            },
            {
              "key": "race_native",
              "label": "Native American"
            },
            {
              "key": "race_white",
              "label": "White"
            },
            {
              "key": "race_other_unknown",
              "label": "Other / unknown"
            }
          ]
        },
        {
          "key": "notes",
          "label": "Anything to flag?",
          "type": "textarea",
          "max": 400
        }
      ]
    },
    {
      "kind": "followup",
      "label": "Follow-up",
      "title": "What happened after release?",
      "blurb": "One participant, one outcome, whenever you hear it.",
      "submit": "Record it",
      "fields": [
        {
          "key": "org",
          "label": "Organization",
          "type": "text",
          "required": true,
          "datalist": "orgs",
          "placeholder": "Defy Ventures"
        },
        {
          "key": "token",
          "label": "Participant ID",
          "type": "text",
          "required": true,
          "placeholder": "M78 — first initial + birth year",
          "max": 12,
          "help": "The same ID that is on their session sheets."
        },
        {
          "key": "release_date",
          "label": "Released on",
          "type": "date",
          "required": true
        },
        {
          "key": "status",
          "label": "Since release",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "no_new_conviction",
              "label": "No new conviction"
            },
            {
              "value": "new_conviction",
              "label": "New conviction"
            },
            {
              "value": "unknown",
              "label": "Don't know"
            }
          ]
        },
        {
          "key": "days",
          "label": "Days after release until conviction",
          "type": "integer",
          "min": 0,
          "max": 3650,
          "show_if": {
            "status": "new_conviction"
          }
        },
        {
          "key": "notes",
          "label": "Anything to flag?",
          "type": "textarea",
          "max": 400
        }
      ],
      "tab": false
    }
  ]
}
